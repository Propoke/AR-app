# Copy to .env and adjust for your environment. Never commit a real .env.

# --- Postgres ---
POSTGRES_USER=ar
POSTGRES_PASSWORD=ar
POSTGRES_DB=ar

# --- Backend ---
# Generate a strong secret in production, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-insecure-secret-change-me
SESSION_TOKEN_TTL=10m
SIGNALING_TOKEN_TTL=4h

# Signaling delivery: "local" (single instance, default) or "redis" (pub/sub
# across replicas — required if you run more than one backend instance).
SIGNALING_FANOUT=local

# Production reverse proxy (docker-compose.prod.yml): the public domain Caddy
# serves and obtains a TLS certificate for.
DOMAIN=support.example.com

# Comma-separated CIDRs of trusted reverse proxies (e.g. Caddy) whose
# X-Forwarded-For header is honored when rate-limiting login/register/redeem by
# client IP. Leave EMPTY when the backend is reached directly with no proxy in
# front of it (the WireGuard/LAN scenario) — otherwise any client could spoof
# X-Forwarded-For and dodge its own rate limit. Only set this when running
# behind Caddy (--profile tls): set it to the docker-compose network's subnet
# (`docker network inspect infra_default` to find it) so only Caddy's container
# is trusted, never a range that real clients could be connecting from.
TRUSTED_PROXY_CIDRS=

# Which interface the backend's raw :8080 is published on. Default (0.0.0.0) is
# correct for the WireGuard/LAN scenario, where clients reach the backend
# directly. When running behind Caddy (--profile tls), set this to 127.0.0.1 so
# :8080 is reachable only from the VM itself and all traffic is forced through
# Caddy's TLS — otherwise the raw HTTP backend stays reachable on every
# interface even with Caddy running, letting anyone who can reach the VM at all
# bypass TLS.
BACKEND_BIND=0.0.0.0

# --- coturn ---
# In dev, this must match infra/coturn/turnserver.conf. In prod
# (docker-compose.prod.yml), coturn reads TURN_SECRET directly, so they always match.
TURN_SECRET=dev-turn-secret
TURN_REALM=ar.local
# The URL clients use to reach coturn (public IP/domain in prod).
TURN_URLS=turn:127.0.0.1:3478?transport=udp
# PROD ONLY: the IP address clients reach coturn on (the host's routable/public IP).
# Required by docker-compose.prod.yml for NAT traversal (e.g. on Proxmox).
# TURN_EXTERNAL_IP=203.0.113.10
# UDP relay port range coturn hands out (open/forward these on the firewall).
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49200

# --- Monitoring (Grafana) ---
# Grafana is published on :3000 over the tunnel/LAN (never forward it to the WAN).
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-strong

# --- Object storage for session recordings (optional) ---
# Recordings are enabled only when S3_ENDPOINT is set.
# S3_ENDPOINT=minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=recordings
# S3_REGION=us-east-1
# S3_USE_SSL=false
