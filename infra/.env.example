# Copy to .env and adjust for your environment. Never commit a real .env.

# --- Postgres ---
POSTGRES_USER=ar
POSTGRES_PASSWORD=ar
POSTGRES_DB=ar

# --- Backend ---
# Generate a strong secret in production, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev-insecure-secret-change-me
SESSION_TOKEN_TTL=10m
SIGNALING_TOKEN_TTL=4h

# Production reverse proxy (docker-compose.prod.yml): the public domain Caddy
# serves and obtains a TLS certificate for.
DOMAIN=support.example.com

# --- coturn (must match infra/coturn/turnserver.conf static-auth-secret) ---
TURN_SECRET=dev-turn-secret
TURN_REALM=ar.local
TURN_URLS=turn:127.0.0.1:3478?transport=udp

# --- Object storage for session recordings (optional) ---
# Recordings are enabled only when S3_ENDPOINT is set.
# S3_ENDPOINT=minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=recordings
# S3_REGION=us-east-1
# S3_USE_SSL=false
