<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AR.Agent.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AR Remote Support — Technician">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Sign in -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ServerBox" PlaceholderText="server URL" Width="240" />
            <TextBox x:Name="EmailBox" PlaceholderText="email" Width="200" />
            <PasswordBox x:Name="PasswordBox" PlaceholderText="password" Width="160" />
            <Button x:Name="TestButton" Content="Test" Click="OnTestConnectionClick" />
            <Button x:Name="LoginButton" Content="Sign in" Click="OnLoginClick" />
        </StackPanel>

        <!-- Start a session -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <Button x:Name="StartButton" Content="Start session" Click="OnStartSessionClick" IsEnabled="False" />
            <TextBlock x:Name="ConnectIdText" FontSize="20" FontFamily="Consolas" VerticalAlignment="Center" />
            <TextBlock x:Name="PinText" FontSize="20" FontFamily="Consolas" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Annotation toolbar: pick a tool, then click on the video to place it -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Annotate:" VerticalAlignment="Center" />
            <RadioButton x:Name="ArrowTool" Content="Arrow" GroupName="Tool" IsChecked="True" />
            <RadioButton x:Name="CircleTool" Content="Circle" GroupName="Tool" />
            <RadioButton x:Name="TextTool" Content="Text" GroupName="Tool" />
            <RadioButton x:Name="MarkerTool" Content="Marker" GroupName="Tool" />
            <Button Content="Clear" Click="OnClearAnnotations" />
        </StackPanel>

        <!-- Live video panel + status overlay. Click to drop an annotation. -->
        <Border Grid.Row="3" Background="#11000000" CornerRadius="8">
            <Grid>
                <Image x:Name="VideoImage" Stretch="Uniform" PointerPressed="OnVideoPointerPressed" />
                <TextBlock x:Name="StatusText" Margin="12" Text="Sign in to begin."
                           TextWrapping="Wrap" VerticalAlignment="Bottom"
                           HorizontalAlignment="Left" />
            </Grid>
        </Border>
    </Grid>
</Window>
